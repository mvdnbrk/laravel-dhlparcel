{
    "name": "mvdnbrk/laravel-dhlparcel",
    "description": "DHL Parcel API client for Laravel",
    "keywords": [
        "laravel",
        "dhl",
        "parcel",
        "api"
    ],
    "homepage": "https://github.com/mvdnbrk/laravel-dhlparcel",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark van den Broek",
            "email": "mvdnbrk@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "mvdnbrk/dhlparcel-php-api": "^2.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mvdnbrk\\Laravel\\DhlParcelServiceProvider"
            ],
            "aliases": {
                "DhlParcel": "Mvdnbrk\\Laravel\\Facades\\DhlParcel"
            }
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Mvdnbrk\\Laravel\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mvdnbrk\\Laravel\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    }
}
